rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function memberOf(t) {
      return isAdmin() ||
        (signedIn() && request.auth.token.tenants != null
         && request.auth.token.tenants[t] == true);
    }
    function isTenantAdmin(t) {
      return signedIn() && request.auth.token.tadmin != null
        && request.auth.token.tadmin[t] == true;
    }
    function isTenantOwner(t) {
      return signedIn() && request.auth.token.towner != null
        && request.auth.token.towner[t] == true;
    }
    function canManage(t) { return isAdmin() || isTenantAdmin(t); }
    function feedPublic(t) {
      let p = /databases/$(database)/documents/tenants/$(t)/settings/app;
      return !exists(p) || get(p).data.get('feedPublic', true) == true;
    }
    function broadcastMode(t) {
      let p = /databases/$(database)/documents/tenants/$(t)/settings/app;
      return exists(p) && get(p).data.get('postMode', 'public') == 'broadcast';
    }

    match /tenants/{t} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isTenantOwner(t)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminLineIds', 'updatedAt']);

      match /settings/{doc} { allow read: if true; allow write: if canManage(t); }
      match /products/{productId} { allow read: if true; allow write: if canManage(t); }
      match /users/{uid} {
        allow read: if isOwner(uid) || memberOf(t) || canManage(t);
        allow create: if isOwner(uid) && memberOf(t)
          && request.resource.data.get('banned', false) == false
          && request.resource.data.get('tier', 'bronze') == 'bronze'
          && request.resource.data.get('points', 0) <= 20;
        allow update: if canManage(t)
          || (isOwner(uid) && memberOf(t)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned', 'tier'])
              && request.resource.data.get('points', 0) <= resource.data.get('points', 0) + 20
              && request.resource.data.get('points', 0) >= resource.data.get('points', 0));
        allow delete: if canManage(t);
        match /diagnoses/{diagId} { allow read, delete: if isOwner(uid); allow write: if false; }
        match /aiUsage/{day}     { allow read: if isOwner(uid); allow write: if false; }
      }
      match /posts/{postId} {
        allow read: if feedPublic(t) || memberOf(t) || canManage(t);
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
          && (broadcastMode(t) ? canManage(t) : memberOf(t));
        allow update: if canManage(t);
        allow delete: if canManage(t) || (signedIn() && resource.data.authorId == request.auth.uid);
        match /comments/{commentId} {
          allow read: if feedPublic(t) || memberOf(t) || canManage(t);
          allow create: if signedIn() && memberOf(t) && request.resource.data.authorId == request.auth.uid;
          allow update: if false;
          allow delete: if canManage(t) || (signedIn() && resource.data.authorId == request.auth.uid);
        }
        match /likes/{uid} { allow read: if feedPublic(t) || memberOf(t) || canManage(t); allow create, update, delete: if isOwner(uid) && memberOf(t); }
        match /helps/{uid} { allow read: if feedPublic(t) || memberOf(t) || canManage(t); allow create, delete: if isOwner(uid) && memberOf(t); allow update: if false; }
      }
      match /orders/{orderId} {
        allow read: if canManage(t) || (signedIn() && resource.data.userId == request.auth.uid);
        allow create: if signedIn() && memberOf(t)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending_payment';
        allow update: if canManage(t)
          || (signedIn() && resource.data.userId == request.auth.uid
              && resource.data.status in ['pending_payment', 'paid_review']
              && request.resource.data.status == 'paid_review'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','slipUrl','paidAt','updatedAt']));
        allow delete: if canManage(t);
      }
      match /notifications/{nid} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    match /tenantRequests/{reqId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.brandName is string
        && request.resource.data.brandName.size() > 0
        && request.resource.data.brandName.size() < 120
        && request.resource.data.contactName is string
        && request.resource.data.contactName.size() > 0
        && request.resource.data.contactName.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 40;
    }

    // LEGACY top-level — ลบใน cleanup
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.get('banned', false) == false
        && request.resource.data.get('tier', 'bronze') == 'bronze'
        && request.resource.data.get('points', 0) <= 20;
      allow update: if isAdmin()
        || (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned', 'tier'])
            && request.resource.data.get('points', 0) <= resource.data.get('points', 0) + 20
            && request.resource.data.get('points', 0) >= resource.data.get('points', 0));
      allow delete: if isAdmin();
      match /diagnoses/{diagId} { allow read, delete: if isOwner(uid); allow write: if false; }
      match /aiUsage/{day}     { allow read: if isOwner(uid); allow write: if false; }
    }
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      }
      match /likes/{uid} { allow read: if signedIn(); allow create, update, delete: if isOwner(uid); }
      match /helps/{uid} { allow read: if signedIn(); allow create, delete: if isOwner(uid); allow update: if false; }
    }
    match /settings/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /products/{productId} { allow read: if true; allow write: if isAdmin(); }
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_payment';
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid
            && resource.data.status in ['pending_payment', 'paid_review']
            && request.resource.data.status == 'paid_review'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','slipUrl','paidAt','updatedAt']));
      allow delete: if isAdmin();
    }
    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}

{
  "hosting": [
    {
      "target": "main",
      "public": ".",
      "ignore": ["firebase.json","**/.*","**/node_modules/**","functions/**","firestore.rules","storage.rules","*.md","index.js","apply_*.js","seed_tenant.js","gen-icons.js","tests/**","public/**","*.sh"],
      "headers": [
        { "source": "**/*.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
        { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" } ] },
        { "source": "/manifest.webmanifest", "headers": [ { "key": "Cache-Control", "value": "no-cache" }, { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" } ] },
        { "source": "/icons/**", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] }
      ],
      "rewrites": [
        { "source": "/s/**", "function": { "functionId": "ogPreview", "region": "asia-southeast1" } },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "office",
      "public": ".",
      "ignore": ["firebase.json","**/.*","**/node_modules/**","functions/**","firestore.rules","storage.rules","*.md","index.js","apply_*.js","seed_tenant.js","gen-icons.js","tests/**","public/**","*.sh"],
      "headers": [
        { "source": "**/*.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
        { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" } ] },
        { "source": "/manifest.webmanifest", "headers": [ { "key": "Cache-Control", "value": "no-cache" }, { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" } ] },
        { "source": "/icons/**", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] }
      ],
      "rewrites": [
        { "source": "/s/**", "function": { "functionId": "ogPreview", "region": "asia-southeast1" } },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "bocean",
      "public": ".",
      "ignore": ["firebase.json","**/.*","**/node_modules/**","functions/**","firestore.rules","storage.rules","*.md","index.html","admin.html","apply_*.js","seed_tenant.js","tests/**","*.sh"],
      "headers": [ { "source": "**", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] } ],
      "rewrites": [ { "source": "**", "destination": "/bocean.html" } ]
    }
  ],
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "functions": [ { "source": "functions", "runtime": "nodejs22" } ],
  "emulators": {
    "firestore": { "port": 8080 },
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "singleProjectMode": true,
    "ui": { "enabled": false }
  }
}

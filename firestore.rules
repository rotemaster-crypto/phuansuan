rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function memberOf(t) {
      return isAdmin() ||
        (signedIn() && request.auth.token.tenants != null
         && request.auth.token.tenants[t] == true);
    }
    function isTenantAdmin(t) {
      return signedIn() && request.auth.token.tadmin != null
        && request.auth.token.tadmin[t] == true;
    }
    function isTenantOwner(t) {
      return signedIn() && request.auth.token.towner != null
        && request.auth.token.towner[t] == true;
    }
    function canManage(t) { return isAdmin() || isTenantAdmin(t); }
    // B4: defense-in-depth — field ตัวเลขเศรษฐกิจต้องเป็น number >= 0 (server clamp อยู่แล้ว
    // แต่กัน client แปลก/บั๊กเขียน string/ติดลบ). ไม่บังคับ field ต้องมี (absent → default 0 = ผ่าน)
    function econNum(d, k) { return d.get(k, 0) is number && d.get(k, 0) >= 0; }
    function econOk(d) {
      return econNum(d, 'costPoints') && econNum(d, 'ratePoints') && econNum(d, 'ratePerBaht')
        && econNum(d, 'bonusPoints') && econNum(d, 'multiplier') && econNum(d, 'rewardPoints')
        && econNum(d, 'minSpend') && econNum(d, 'maxEntries') && econNum(d, 'goal')
        && econNum(d, 'discountValue');
    }
    function feedPublic(t) {
      let p = /databases/$(database)/documents/tenants/$(t)/settings/app;
      return !exists(p) || get(p).data.get('feedPublic', true) == true;
    }
    function broadcastMode(t) {
      let p = /databases/$(database)/documents/tenants/$(t)/settings/app;
      return exists(p) && get(p).data.get('postMode', 'public') == 'broadcast';
    }

    match /tenants/{t} {
      // A8: เอกสารร้านมี ownerLineId/adminLineIds (= PII + UID ที่ใช้ gating) —
      //     ล็อกอ่านเฉพาะสมาชิก/แอดมินร้านนั้น · list ทั้งคอลเลกชันเฉพาะ super-admin
      //     (ลูกค้าอ่าน branding จาก settings/app ไม่อ่าน doc นี้)
      allow get: if memberOf(t) || canManage(t);
      allow list: if isAdmin();
      allow write: if isAdmin();
      allow update: if isTenantOwner(t)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminLineIds', 'updatedAt']);

      // A8: settings ส่วนใหญ่ public (ลูกค้าอ่าน branding/flags/commerce) — ยกเว้น
      //     'store' (ชื่อ/เบอร์/ที่อยู่ผู้ส่ง = business PII) อ่านได้เฉพาะแอดมิน
      match /settings/{doc} {
        allow read: if doc != 'store' || canManage(t);
        allow write: if canManage(t);
      }
      // ข้อมูลลับต่อแบรนด์ (เช่น API key ขนส่ง) — เข้าถึงผ่าน Cloud Function เท่านั้น
      match /private/{doc} { allow read, write: if false; }
      match /products/{productId} { allow read: if true; allow write: if canManage(t); }
      // สุ่มจับรางวัล (Activity Engine) — แอดมินสร้าง/แก้ · ผู้ใช้อ่านได้ · หมุนจริงผ่าน Cloud Function เท่านั้น
      match /luckyDraws/{drawId} { allow read: if true; allow create, update: if canManage(t) && econOk(request.resource.data); allow delete: if canManage(t); }
      // ภารกิจ/แคมเปญ (Phase 4) — แอดมินสร้าง/แก้ · ผู้ใช้อ่านได้ · รับรางวัลผ่าน Cloud Function เท่านั้น
      match /missions/{mid} { allow read: if true; allow create, update: if canManage(t) && econOk(request.resource.data); allow delete: if canManage(t); }
      // แคมเปญแต้ม (Campaign builder) — กติกาสะสมแต้ม (ซื้อ/โพสต์) · แอดมินตั้ง · ผู้ใช้อ่านได้ · ให้แต้มผ่าน Cloud Function เท่านั้น
      match /earnCampaigns/{id} { allow read: if true; allow create, update: if canManage(t) && econOk(request.resource.data); allow delete: if canManage(t); }
      // ทายผล (Prediction) — แอดมินสร้าง/เฉลย · ผู้ใช้อ่านได้ · ส่งคำทาย+จ่ายรางวัลผ่าน Cloud Function เท่านั้น
      match /predictions/{pid} {
        allow read: if true;
        allow create, update: if canManage(t) && econOk(request.resource.data);
        allow delete: if canManage(t);
        // คำทายแต่ละครั้ง (auto-id, มี field uid) — เจ้าของ (ดูจาก data.uid) หรือแอดมินอ่านได้ · เขียนผ่าน Cloud Function เท่านั้น
        match /entries/{eid} { allow read: if canManage(t) || (signedIn() && resource.data.uid == request.auth.uid); allow write: if false; }
        // ตัวนับจำนวนครั้งที่ user เล่น (doc-id = uid)
        match /userCounts/{uid} { allow read: if isOwner(uid) || canManage(t); allow write: if false; }
      }
      match /users/{uid} {
        allow read: if isOwner(uid) || memberOf(t) || canManage(t);
        allow create: if isOwner(uid) && memberOf(t)
          && request.resource.data.get('banned', false) == false
          && request.resource.data.get('tier', 'bronze') == 'bronze'
          && request.resource.data.get('points', 0) == 0;   // A5: แต้มเริ่มต้อง 0 — โบนัสให้ผ่าน Cloud Function
        // A5: เจ้าของแก้ได้เฉพาะ field ที่ไม่ใช่ economy/identity —
        //     points/tier/postCount/helpCount/banned/lastBonusDay เขียนได้เฉพาะ Cloud Function (กันปั๊มแต้ม)
        allow update: if canManage(t)
          || (isOwner(uid) && memberOf(t)
              && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['points', 'tier', 'banned', 'postCount', 'helpCount', 'lastBonusDay']));
        allow delete: if canManage(t);
        match /diagnoses/{diagId} { allow read, delete: if isOwner(uid); allow write: if false; }
        match /aiUsage/{day}     { allow read: if isOwner(uid); allow write: if false; }
        // คูปองที่สุ่มได้ — เจ้าของ/แอดมินอ่าน · เขียนโดย Cloud Function เท่านั้น (client เขียนไม่ได้)
        match /coupons/{cid}     { allow read: if isOwner(uid) || canManage(t); allow write: if false; }
        // การรับรางวัลภารกิจ — เจ้าของ/แอดมินอ่าน · เขียนโดย Cloud Function เท่านั้น (กันรับซ้ำ)
        match /missionClaims/{mid} { allow read: if isOwner(uid) || canManage(t); allow write: if false; }
      }
      match /posts/{postId} {
        allow read: if feedPublic(t) || memberOf(t) || canManage(t);
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
          && (broadcastMode(t) ? canManage(t) : memberOf(t));
        allow update: if canManage(t);
        allow delete: if canManage(t) || (signedIn() && resource.data.authorId == request.auth.uid);
        match /comments/{commentId} {
          allow read: if feedPublic(t) || memberOf(t) || canManage(t);
          allow create: if signedIn() && memberOf(t) && request.resource.data.authorId == request.auth.uid;
          allow update: if false;
          allow delete: if canManage(t) || (signedIn() && resource.data.authorId == request.auth.uid);
        }
        match /likes/{uid} { allow read: if feedPublic(t) || memberOf(t) || canManage(t); allow create, update, delete: if isOwner(uid) && memberOf(t); }
        match /helps/{uid} { allow read: if feedPublic(t) || memberOf(t) || canManage(t); allow create, delete: if isOwner(uid) && memberOf(t); allow update: if false; }
      }
      match /groups/{gid} {
        allow read: if feedPublic(t) || memberOf(t) || canManage(t);
        allow create, update, delete: if canManage(t);
        match /members/{uid} {
          allow read: if feedPublic(t) || memberOf(t) || canManage(t);
          allow create, delete: if isOwner(uid) && memberOf(t);
          allow update: if false;
        }
      }
      match /orders/{orderId} {
        allow read: if canManage(t) || (signedIn() && resource.data.userId == request.auth.uid);
        allow create: if signedIn() && memberOf(t)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending_payment';
        // B2: admin แก้ field อื่นได้ แต่ "status" เปลี่ยนต้องผ่าน callable setOrderStatus
        //     (admin SDK) เท่านั้น — กัน admin กระโดดสถานะข้ามขั้นจาก client (DAT-6)
        allow update: if (canManage(t) && request.resource.data.status == resource.data.status)
          || (signedIn() && resource.data.userId == request.auth.uid
              && resource.data.status in ['pending_payment', 'paid_review']
              && request.resource.data.status == 'paid_review'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','slipUrl','paidAt','updatedAt']))
          // เจ้าของแก้ที่อยู่จัดส่งได้เอง ตราบใดที่ยังไม่จัดส่ง (สถานะไม่เปลี่ยน)
          || (signedIn() && resource.data.userId == request.auth.uid
              && resource.data.status in ['pending_payment', 'paid_review', 'confirmed']
              && request.resource.data.status == resource.data.status
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shipping','updatedAt']));
        allow delete: if canManage(t);
      }
      match /notifications/{nid} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    match /tenantRequests/{reqId} {
      allow read, update, delete: if isAdmin();
      // A10: ต้อง login ก่อน (กันสแปม lead จากคนนอกที่ไม่ระบุตัว)
      allow create: if signedIn()
        && request.resource.data.status == 'new'
        && request.resource.data.brandName is string
        && request.resource.data.brandName.size() > 0
        && request.resource.data.brandName.size() < 120
        && request.resource.data.contactName is string
        && request.resource.data.contactName.size() > 0
        && request.resource.data.contactName.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 40;
    }

    // (legacy top-level rules ลบออกแล้ว 2026-08-24 — ทุก path ใช้ tenants/{t}/... เท่านั้น)
    // backup: docs/_archive/firestore.rules_*.bak

    match /{document=**} { allow read, write: if false; }
  }
}

rules_version = '2';
// ============================================================
//  storage.rules — เพื่อนสวน
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function underLimit(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // รูปโพส — login แล้วอัพได้ เฉพาะรูป ไม่เกิน 5MB
    match /posts/{fileName} {
      allow read: if true;
      allow write: if signedIn() && isImage() && underLimit(5);
    }

    match /covers/{fileName} {
      allow read: if true;
      allow write: if signedIn() && isImage() && underLimit(5);
    }

    // ไอคอน/โลโก้แอป — admin เท่านั้น ไม่เกิน 2MB
    match /app-icons/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underLimit(2);
    }

    // ปิดทุกอย่างที่เหลือ
    // สลิปโอนเงิน — login แล้วอัพได้ เฉพาะรูป ไม่เกิน 5MB
    match /slips/{tenant}/{uid}/{fileName} {
      allow read:  if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid && isImage() && underLimit(5);
    }

    // แบนเนอร์ร้าน — admin อัพได้ เฉพาะรูป ไม่เกิน 5MB
    match /shop-banner/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underLimit(5);
    }

    // รูปสินค้า — super-admin หรือ tenant-admin ของแบรนด์นั้น · เฉพาะรูป ไม่เกิน 5MB
    match /products/{tenant}/{fileName} {
      allow read: if true;
      allow write: if isImage() && underLimit(5)
        && (isAdmin() || (signedIn() && request.auth.token.tadmin != null && request.auth.token.tadmin[tenant] == true));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
